{
  "name": "anyllm-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "quality": "pnpm -r build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:docs && pnpm check:packages && pnpm test:runtime && pnpm test:scripts && pnpm test:audit-gate && pnpm test",
    "check:packages": "pnpm -r exec publint --strict && pnpm -r exec attw --pack .",
    "test:runtime": "node --import ./scripts/runtime-smoke/register.mjs scripts/runtime-smoke/entry.mjs",
    "check:docs": "node scripts/check-doc-snippets.test.mjs && node scripts/check-doc-snippets.mjs",
    "clean": "pnpm -r exec rm -rf dist",
    "example": "tsx examples/basic.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "audit:gate": "node scripts/audit.mjs --audit-level=high",
    "test:scripts": "node scripts/recapture-fixtures.test.mjs",
    "test:audit-gate": "node scripts/audit.test.mjs",
    "test:packed-install": "pnpm -r build && node scripts/packed-install.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@gullabs/any-llm": "workspace:*",
    "@gullabs/core": "workspace:*",
    "@gullabs/google": "workspace:*",
    "@gullabs/testing": "workspace:*",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "publint": "0.3.25",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.24.0"
}
