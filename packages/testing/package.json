{
  "name": "@gullabs/testing",
  "version": "0.16.0",
  "description": "Test fakes for any-llm: FakeClock (clock and scheduler), FakeClient, FakeAdapter, error factories, recording sink, telemetry and logger, fake Gemini and xAI SDK clients, fake stores and CLI runner. No network in tests.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gul-labs/any-llm.git",
    "directory": "packages/testing"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@google/genai": "^2",
    "@gullabs/core": "workspace:*",
    "@gullabs/google": "workspace:*",
    "@gullabs/xai": "workspace:*",
    "openai": "^7"
  },
  "devDependencies": {
    "@google/genai": "^2.24.0",
    "@gullabs/core": "workspace:*",
    "@gullabs/google": "workspace:*",
    "@gullabs/xai": "workspace:*",
    "openai": "^7.23.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "keywords": [
    "llm",
    "gemini",
    "google-genai",
    "ai",
    "tokens",
    "cost",
    "usage",
    "observability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gul-labs/any-llm/tree/main/packages/testing#readme",
  "bugs": "https://github.com/gul-labs/any-llm/issues",
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    },
    "@gullabs/google": {
      "optional": true
    },
    "@gullabs/xai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  }
}
