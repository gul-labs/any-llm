{
  "name": "@gullabs/drizzle",
  "version": "0.7.2",
  "description": "Drizzle ORM companion for any-llm — reference llm_calls schema and UsageSink for Postgres.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gul-labs/any-llm.git",
    "directory": "packages/drizzle"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./sql/*": "./sql/*"
  },
  "files": [
    "dist",
    "sql",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@gullabs/core": "workspace:*",
    "drizzle-orm": ">=0.36 <1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@gullabs/core": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "postgres": "^3.4.9"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "keywords": [
    "llm",
    "gemini",
    "google-genai",
    "ai",
    "tokens",
    "cost",
    "usage",
    "observability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gul-labs/any-llm/tree/main/packages/drizzle#readme",
  "bugs": "https://github.com/gul-labs/any-llm/issues"
}
