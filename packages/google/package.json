{
  "name": "@gullabs/google",
  "version": "0.13.0",
  "description": "Gemini provider adapter for any-llm — Flex tier, thinking capture, structured output, error classification.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gul-labs/any-llm.git",
    "directory": "packages/google"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@google/genai": "^2",
    "@gullabs/core": "workspace:*"
  },
  "devDependencies": {
    "@google/genai": "^2.24.0",
    "@gullabs/core": "workspace:*",
    "@gullabs/testing": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "keywords": [
    "llm",
    "gemini",
    "google-genai",
    "ai",
    "tokens",
    "cost",
    "usage",
    "observability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gul-labs/any-llm/tree/main/packages/google#readme",
  "bugs": "https://github.com/gul-labs/any-llm/issues"
}
