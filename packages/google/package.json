{
  "name": "@gullabs/google",
  "version": "0.12.0",
  "description": "Gemini provider adapter for any-llm — Flex tier, thinking capture, structured output, error classification.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gul-labs/any-llm.git",
    "directory": "packages/google"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@gullabs/core": "workspace:*",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@google/genai": "^2"
  },
  "devDependencies": {
    "@google/genai": "^2.20.0",
    "@gullabs/testing": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "keywords": [
    "llm",
    "gemini",
    "google-genai",
    "ai",
    "tokens",
    "cost",
    "usage",
    "observability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gul-labs/any-llm/tree/main/packages/google#readme",
  "bugs": "https://github.com/gul-labs/any-llm/issues"
