{
  "name": "@gullabs/claude-cli",
  "version": "0.6.0",
  "description": "Dev-only Claude Code CLI provider adapter for any-llm — routes calls through a locally-authenticated `claude` CLI session for $0 API spend during workflow iteration. NOT for production use.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gul-labs/any-llm.git",
    "directory": "packages/claude-cli"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@gullabs/core": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@gullabs/testing": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "keywords": [
    "llm",
    "dev-only",
    "cli",
    "claude",
    "testing",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gul-labs/any-llm/tree/main/packages/claude-cli#readme",
  "bugs": "https://github.com/gul-labs/any-llm/issues"
}
