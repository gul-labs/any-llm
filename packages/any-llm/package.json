{
  "name": "@gullabs/any-llm",
  "version": "0.11.1",
  "description": "Batteries-included any-llm client for Gemini: engine, adapter, and Google SDK in one install.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gul-labs/any-llm.git",
    "directory": "packages/any-llm"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@gullabs/google": "workspace:*"
  },
  "peerDependencies": {
    "@gullabs/core": "workspace:*"
  },
  "devDependencies": {
    "@gullabs/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "keywords": [
    "llm",
    "gemini",
    "google-genai",
    "ai",
    "tokens",
    "cost",
    "usage",
    "observability",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gul-labs/any-llm/tree/main/packages/any-llm#readme",
  "bugs": "https://github.com/gul-labs/any-llm/issues"
}
